      "source": [ "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import statsmodels.api as sm\n",
        "import statsmodels.formula.api as smf\n",
        "\n",
        "# 1. 분석 대상 데이터 준비 (df는 기존 전처리가 완료된 메인 데이터프레임)\n",
        "df_analysis = df.dropna(subset=['hypertension', 'income_q1', 'age', 'sex']).copy()\n",
        "\n",
        "# 2. 무보정 로지스틱 회귀분석 (Model 1: 소득 1분위 vs 고혈압)\n",
        "model_crude = smf.logit('hypertension ~ income_q1', data=df_analysis).fit(disp=0)\n",
        "or_crude = np.exp(model_crude.params['income_q1'])\n",
        "ci_crude = np.exp(model_crude.conf_int().loc['income_q1'])\n",
        "pval_crude = model_crude.pvalues['income_q1']\n",
        "\n",
        "# 3. 보정 로지스틱 회귀분석 (Model 2: 연령, 성별 등 교락변수 보정)\n",
        "model_adj = smf.logit('hypertension ~ income_q1 + age + sex', data=df_analysis).fit(disp=0)\n",
        "or_adj = np.exp(model_adj.params['income_q1'])\n",
        "ci_adj = np.exp(model_adj.conf_int().loc['income_q1'])\n",
        "pval_adj = model_adj.pvalues['income_q1']\n",
        "\n",
        "# 4. Table 2 결과 데이터프레임 생성 (자동 계산된 값 적용)\n",
        "data_table2 = {\n",
        "    \"변수\": [\"소득 1분위 (vs. 2~4분위)\"],\n",
        "    \"무보정 OR (95% CI)\": [f\"{or_crude:.3f} ({ci_crude[0]:.3f}–{ci_crude[1]:.3f})\"],\n",
        "    \"보정 OR (95% CI)\": [f\"{or_adj:.3f} ({ci_adj[0]:.3f}–{ci_adj[1]:.3f})\"],\n",
        "    \"p-value (보정)\": [f\"{pval_adj:.3f}\" if pval_adj >= 0.001 else \"<0.001\"]\n",
        "}\n",
        "\n",
        "df_table2 = pd.DataFrame(data_table2)\n",
        "\n",
        "# 5. 최종 결과 출력\n",
        "print(\"**Table 2. 소득 1분위와 고혈압의 관련성 (분석 결과)**\")\n",
        "display(df_table2)"
    ]
       
