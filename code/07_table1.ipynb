      "source": [
        "import pandas as pd\n",
        "\n",
        "# 표 데이터를 딕셔너리 형태로 정의합니다.\n",
        "data = {\n",
        "    \"변수\": [\n",
        "        \"연령 (age)\",\n",
        "        \"성별 (sex)\",\n",
        "        \"교육수준 (edu)\",\n",
        "        \"거주지역 (urban)\",\n",
        "        \"신체활동 (exercise)\",\n",
        "        \"체질량지수 (bmi)\",\n",
        "        \"총콜레스테롤 (chol)\",\n",
        "        \"조사연도 (year)\"\n",
        "    ],\n",
        "    \"유형\": [\n",
        "        \"교란변수\",\n",
        "        \"교란변수\",\n",
        "        \"교란변수\",\n",
        "        \"교란변수\",\n",
        "        \"매개변수\",\n",
        "        \"매개변수\",\n",
        "        \"충돌부(가정)\",\n",
        "        \"무관변수\"\n",
        "    ],\n",
        "    \"분류 근거\": [\n",
        "        \"연령에 따라 소득 수준과 고혈압 유병 가능성이 모두 달라질 수 있다.\",\n",
        "        \"성별은 경제활동과 소득 분포뿐 아니라 고혈압 유병 양상에도 영향을 미칠 수 있다.\",\n",
        "        \"교육수준은 소득 형성에 영향을 주며 건강정보 이해 및 건강관리에도 영향을 줄 수 있다.\",\n",
        "        \"동부와 읍면부 간 소득 분포, 의료 접근성 및 생활환경의 차이가 고혈압과 관련될 수 있다.\",\n",
        "        \"소득 수준에 따른 운동 환경의 차이가 신체활동에 영향을 미치고, 신체활동은 BMI를 통해 고혈압에 영향을 미칠 수 있다.\",\n",
        "        \"소득 수준에 따른 생활습관 차이가 BMI에 영향을 미치며, BMI는 고혈압 발생과 관련될 수 있다.\",\n",
        "        \"BMI와 신체활동이 모두 총콜레스테롤에 영향을 미치는 구조를 가정하면 두 화살표가 모이는 충돌부에 해당한다.\",\n",
        "        \"모든 대상자의 조사연도가 2024년으로 동일하여 개인 간 소득 및 고혈압의 차이를 설명하지 못한다.\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "# pandas DataFrame 객체를 생성합니다.\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# 코랩에서 표를 예쁘게 출력합니다.\n",
        "display(df)"
      ],
